# Minimal, host-safe .htaccess for php_api
# Only include a conservative rewrite rule; avoid Header and other
# directives that can trigger 500 errors on some shared hosts.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /php_api/
    RewriteRule ^api/(.*)$ api/$1.php [L,QSA]
</IfModule>

# If you still see 500 errors, temporarily rename this file to
# .htaccess.disabled and re-test (you mentioned that helped earlier).
